# 🔐 SEGURANÇA
# Token secreto para validar webhooks do Pipefy
WEBHOOK_TOKEN=seu-token-super-secreto-aqui

# Token de autenticação da API do Pipefy
# Obtenha em: https://app.pipefy.com/tokens
PIPEFY_TOKEN=seu-token-pipefy-aqui

# 🌍 TIMEZONE E HORÁRIO COMERCIAL
# Timezone para cálculo de datas (padrão: America/Fortaleza = UTC-3)
TIMEZONE=America/Fortaleza

# Horário de início do expediente (formato 24h: HH:mm)
BUSINESS_START=08:00

# Horário de fim do expediente (formato 24h: HH:mm)
BUSINESS_END=18:00

# 📅 FERIADOS
# Lista de feriados em formato JSON (YYYY-MM-DD)
# Inclua feriados nacionais, estaduais e municipais relevantes
HOLIDAYS_JSON=["2026-01-01","2026-02-16","2026-02-17","2026-04-03","2026-04-21","2026-05-01","2026-06-04","2026-09-07","2026-10-12","2026-11-02","2026-11-15","2026-12-25"]

# 🎯 CONFIGURAÇÃO DO PIPEFY
# ID do pipe onde a automação será aplicada
PIPE_ID=seu-pipe-id-aqui

# IDs dos campos customizados no Pipefy
# Para descobrir os IDs: use a query GraphQL ou inspecione o card
FIELD_SLA_START=campo_inicio_sla
FIELD_SLA_DEADLINE=campo_prazo_limite
FIELD_SLA_STATUS=campo_status_sla

# ⚙️ CONFIGURAÇÃO DO SERVIDOR
# Porta onde a API vai rodar
PORT=3000

# Ambiente (development, production)
NODE_ENV=development
